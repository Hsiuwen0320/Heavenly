#圓餅圖：plt.pie([資料點x])
#labels參數設定標籤
#legend產生圖例
#labeldistance參數設定標籤位置，0表示圓心，1表示圓周
from cProfile import label
import matplotlib.pyplot as plt
plt.rc('font',family= 'BiauKai') #標楷體支援中文顯示
x=[20,30,40]
total=sum(x)
labels=[str(round(100*x[0]/total,2))+'%' for data in x] #label四捨五入標籤第二位
plt.pie(
    [20,30,40],
    labels=labels,
    labeldistance=0.5
) #設定完標籤後，呼叫legend產生圖例
plt.legend()
plt.show()
