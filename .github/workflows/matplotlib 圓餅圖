import matplotlib.pyplot as plt
plt.rc('font',family= 'BiauKai')
import csv
with open('/Users/chenghsiuwen/Desktop/data.csv','r',encoding='utf-8',errors='replace') as file: #匯入csv檔，用路徑
    reader=csv.reader(file) #讀取csv檔
    next(reader)#讀取第一列
    x=[]
    labels=[]
    for row in reader:
        labels.append(row[0]) #row[0]Chrome
        x.append(row[1]) #row[1]60
    plt.pie(x,labels=labels,labeldistance=0.5)
    plt.legend() #圖例
    plt.title('瀏覽器市場分布')
    plt.show()
