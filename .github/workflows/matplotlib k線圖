import matplotlib.pyplot as plt
import csv
plt.rc('font',family='Biaukai')
with open('/Users/chenghsiuwen/Desktop/candlestick.csv',encoding='utf-8') as file: #讀取文件開頭出現\ufeff-->utf-8-sig
    reader=csv.reader(file)
    header=next(reader)
    for row in reader:
        date=row[0]
        open_price=int(row[1])
        close_price=int(row[2])
        highest=int(row[3])
        lowest=int(row[4])
        #決定陰陽（上下跌）
        color='green'
        if close_price>open_price:
            color='red'
        plt.bar(
            date,
            abs(open_price-close_price), #差值取絕對值
            bottom=min(open_price,close_price), #取最小
            color=color,width=0.5
        ) #陰陽
        plt.bar(date,highest-lowest,bottom=lowest,color=color,width=0.1) #影
    plt.xlabel('日期')
    plt.ylabel('價格')
    plt.title('股票走勢')
    plt.show()
