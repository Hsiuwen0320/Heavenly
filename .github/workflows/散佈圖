from cProfile import label

import matplotlib.pyplot as plt
import csv
with open('/Users/chenghsiuwen/Desktop/scatter.csv',encoding='utf-8') as file:
    reader=csv.reader(file)
    next(reader)#讀取第一列（跳過）
    data={
        '男':{"x":[],"y":[]},
        '女':{"x":[],"y":[]}
    } #初始化結構
    for row in reader:
        gender=row[0] #性別
        data[gender]['x'].append(int(row[1])) #身高
        data[gender]['y'].append(int(row[2])) #體重
    plt.scatter(data['男']['x'],data['男']['y'],label='boy',c='blue',s=10)
    plt.scatter(data['女']['x'],data['女']['y'],label='girl',c='pink',s=10)
    plt.legend()
    plt.show()

