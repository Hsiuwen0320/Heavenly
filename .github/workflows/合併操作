#合併操作stacking：將數個多維陣列合併成一個
#合併第一個維度：np.vstack((陣列一,陣列二,...)) 用一個tuple合
#合併第二個維度：np.hstack((陣列一,陣列二,...))
import numpy as np
arr1=np.array([
    [3,4,5],
    [5,6,7]
]) #2x3
arr2=np.array([
    [1,2,3],
    [8,9,0]
]) #2x3
#合併第一個維度
result1=np.vstack((arr1,arr2))
print(result1)
"""
    4(2+2)x3
    [
      [3,4,5],
      [5,6,7],
      [1,2,3],
      [8,9,0]
    ]
"""
#合併第二個維度
result2=np.hstack((arr1,arr2))
print(result2)
"""
   2x6(3+3)
   [
     [3,4,5,1,2,3],
     [5,6,7,8,9,0]
   ]
"""
arr3=np.array([
    [11,12],
    [13,14]
]) #2x2
#合併第二個維度
result3=np.hstack((arr1,arr2,arr3))
print(result3)
