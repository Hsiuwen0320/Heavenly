import csv
from xxlimited_35 import error

with open('/Users/chenghsiuwen/Desktop/grades.csv',encoding='utf-8') as file:
    reader=csv.reader(file)
    x=[] #輸入：時間
    y=[] #輸出：考試成績
    for row in reader:
        x.append(float(row[0]))
        y.append(float(row[1]))
    #建立模型 y=w*x
    lr=0.01 #定義學習率
    w=2 #隨機給定一個權重
    #根據第一筆資料做訓練
    for i in range(len(x)):
        output=w*x[i]
        error=y[i]-output
        gradient=error
        w=w+gradient*lr
    print('Final weight',w)
#評估模型 MSE(Mean Square Error) 均方根誤差
    total_error=0
    for i in range(len(x)):
        output=w*x[i]
        error=y[i]-output
        total_error+=error**2
    print('MSE',total_error/len(x))
