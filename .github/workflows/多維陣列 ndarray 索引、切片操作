#多維陣列ndarray索引、切片操作
#切片slicing [開始：結束索引]結束不顯示
#多維陣列[開始索引：結束索引,（第一維度）開始索引：結束索引 (第二維度)]
import numpy as np
data=np.array([
    [0,1],
    [10,-5],
    [2,6]
])
print(data[0,1]) #1
print(data[1,0]) #10
print(data[2,0]) #2
#單維度切片
data=np.array([-1,-5,2,3])
print(data[0:3])#[-1 -5  2]
print(data[:2])#[-1 -5]
print(data[2:])#[2 3]
#多維度的切片
data=np.array([
    [0,1,2],[3,4,5],
    [5,4,3],[2,1,0]
]) #4x3
print(data[1:3,0:2]) #[[3,4],[[5,4]]
print(data[0:2,1])#[1,4]
#使用...全都要
data=np.array([
    [
        [8,1,3],[-5,5,2]
    ],
    [
        [0,1,6],[4,4,-3]
    ]
])#2x2x3
print(data[0,...])#[[ 8  1  3],[-5  5  2]] 第一筆全部
print(data[...,1:3]) #[[[1,3],[5,2],[1,6],[4,-3]]] 最後一層1:3
