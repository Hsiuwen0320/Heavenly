import matplotlib.pyplot as plt
import pandas as pd
#file=pd.read_csv('/Users/chenghsiuwen/Desktop/data.csv',encoding='utf-8')
import csv
with open('/Users/chenghsiuwen/Desktop/data.csv') as file: #匯入csv檔，用路徑
    reader=csv.reader(file) #讀取csv檔
    header=next(reader)
    print('標頭',header) #讀取第一列
    x=[]#[2002,2025]
    y=[]#[[1000,3000],[300,32000]]
    for row in reader:
        print(row)
        x.append(int(row[0]))#讀出來的第一個欄位放到x
        y.append([int(row[1]),int(row[2])])#讀出來的第二、三個欄位放到y
    plt.plot(x,y,label=header[1:3])
    plt.legend()#使用legend方法產生圖例
    plt.xlabel(header[0])#軸線標題：xlabel,ylabel
    plt.ylabel('Salary')
    plt.show()
